# -----------------------------------------------------------------------------
# Enterprise Text-to-SQL Analytics Platform Configuration
# -----------------------------------------------------------------------------

PROJECT_NAME="AI-Powered Text-to-SQL Analytics Platform"
API_V1_STR="/api/v1"

# Security Configuration
SECRET_KEY="REPLACE_THIS_WITH_A_SECURE_RANDOM_STRING_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Metadata Database (Platform DB - users, logs, dashboards, queries)
METADATA_DATABASE_URL="sqlite:///./metadata.db"

# Target Database (Database to run queries against)
# By default, use sqlite for a fully self-contained local developer experience
TARGET_DATABASE_URL="sqlite:///./sample_ecommerce.db"
# Postgres Example: postgresql://postgres:postgres@localhost:5432/ecommerce_db
# MySQL Example: mysql+pymysql://user:password@localhost:3306/ecommerce_db

# LLM Configuration
LLM_PROVIDER="local"

# Vector Embedding Configuration for Schema RAG
# Supported values: "local" (uses sentence-transformers), "gemini", "openai"
EMBEDDINGS_PROVIDER="local"
EMBEDDINGS_MODEL_NAME="all-MiniLM-L6-v2"
VECTOR_DB_PATH="./faiss_index"
MAX_RELEVANT_TABLES=6
SIMILARITY_THRESHOLD=0.3

# Query execution constraints
MAX_ROWS_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
